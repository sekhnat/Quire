<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 backup rules (API 30). Android 12+ reads data_extraction_rules.xml instead.
  Listing includes turns the default "back up everything" off: only the user's own data
  travels — the snapshot file and the settings file. The database (mostly the rebuildable
  text index), cover thumbnails and anything else never reach the backup, which is what
  keeps the backup under the 25 MB Auto Backup quota.
-->
<full-backup-content>
    <include domain="file" path="backup/user-data.json" />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="backup/user-data.json.tmp" />
</full-backup-content>
