<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (cloud backup and device-to-device transfer). The
  <include> elements switch the default "extract everything" off: only the user's own data
  travels — the snapshot file and the settings file. The database (mostly the rebuildable
  text index), cover thumbnails and anything else never travel, which is what keeps cloud
  backups under the 25 MB Auto Backup quota and makes device transfers fast.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/user-data.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="backup/user-data.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/user-data.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="backup/user-data.json.tmp" />
    </device-transfer>
</data-extraction-rules>
